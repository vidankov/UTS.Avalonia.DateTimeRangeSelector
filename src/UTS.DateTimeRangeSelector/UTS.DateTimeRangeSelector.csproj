<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>UTS.Avalonia.DateTimeRangeSelector</PackageId>
		<Version>0.0.8</Version>
		<Authors>UTS</Authors>
		<Description>Avalonia controls for selecting date/time ranges (DateTimeRangeSelector and DateTimePickerPanel).</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/QuickLeopard/UTS.Avalonia.DateTimeRangeSelector</PackageProjectUrl>
		<RepositoryUrl>https://github.com/QuickLeopard/UTS.Avalonia.DateTimeRangeSelector</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>avalonia;datetime;daterange;picker;control</PackageTags>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="System.Reactive" Version="$(SystemReactiveVersion)" />
		<PackageReference Include="Xaml.Behaviors" Version="11.3.9.6" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Styles\**\*.axaml" />
		<AvaloniaResource Include="Themes\**\*.axaml" />
		<AvaloniaResource Include="Themes\DateTimeRangeSelectorTheme.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <AvaloniaResource Update="Styles\ConstrainedCalendarDatePicker.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Styles\DateTimePickerPanel.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	  <AvaloniaResource Update="Styles\DateTimeRangeSelector.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaResource>
	</ItemGroup>

</Project>
