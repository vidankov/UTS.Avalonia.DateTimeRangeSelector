<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:themes="clr-namespace:UTS.DateTimeRangeSelector.Themes;assembly=UTS.DateTimeRangeSelector"
			 x:Class="UTS.DateTimeRangeSelector.DemoApp.App"
			 xmlns:local="using:UTS.DateTimeRangeSelector.DemoApp"
			 RequestedThemeVariant="Default">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme />
		<themes:DateTimeRangeSelectorTheme />
	</Application.Styles>
</Application>