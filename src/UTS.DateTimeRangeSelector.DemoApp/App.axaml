<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
			 xmlns:generation="using:ActiproSoftware.UI.Avalonia.Themes.Generation"
			 xmlns:themes="clr-namespace:UTS.DateTimeRangeSelector.Themes;assembly=UTS.DateTimeRangeSelector"
			 x:Class="UTS.DateTimeRangeSelector.DemoApp.App"
			 xmlns:local="using:UTS.DateTimeRangeSelector.DemoApp"
			 RequestedThemeVariant="Default">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme />
		<themes:DateTimeRangeSelectorTheme />
		<actipro:ModernTheme>
			<actipro:ModernTheme.Definition>
				<generation:ThemeDefinition ScrollBarThumbMaxAscent="12" />
			</actipro:ModernTheme.Definition>
		</actipro:ModernTheme>
	</Application.Styles>
</Application>