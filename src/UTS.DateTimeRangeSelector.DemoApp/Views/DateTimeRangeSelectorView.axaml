<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:UTS.DateTimeRangeSelector.DemoApp.ViewModels"
			 xmlns:controls="clr-namespace:UTS.DateTimeRangeSelector.Controls;assembly=UTS.DateTimeRangeSelector"
			 xmlns:converters="clr-namespace:UTS.DateTimeRangeSelector.DemoApp.Converters"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="UTS.DateTimeRangeSelector.DemoApp.Views.DateTimeRangeSelectorView"
			 x:DataType="vm:DateTimeRangeSelectorViewModel">

	<UserControl.Resources>
		<converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
	</UserControl.Resources>

	<Design.DataContext>
		<vm:DateTimeRangeSelectorViewModel />
	</Design.DataContext>

	<ScrollViewer>
		<StackPanel Margin="20" Spacing="15">

			<TextBlock Text="Демонстрация DateTimeRangeSelector" FontSize="20" FontWeight="Bold" />

			<Border BorderBrush="Gray" BorderThickness="1" Padding="10">
				<StackPanel Spacing="10">
					<!-- Кнопки изменения границ -->
					<StackPanel Orientation="Horizontal" Spacing="5">
						<Button Command="{Binding IncreaseMinCommand}" Content="Min +1 день" />
						<Button Command="{Binding DecreaseMinCommand}" Content="Min -1 день" />
						<Button Command="{Binding IncreaseMaxCommand}" Content="Max +1 день" />
						<Button Command="{Binding DecreaseMaxCommand}" Content="Max -1 день" />
					</StackPanel>
					<TextBlock Text="{Binding RangeMin, StringFormat='Min: {0:dd.MM.yyyy HH:mm}'}" />
					<TextBlock Text="{Binding RangeMax, StringFormat='Max: {0:dd.MM.yyyy HH:mm}'}" />

					<!-- Кнопка смены ориентации -->
					<Button Command="{Binding ToggleOrientationCommand}"
							Content="Переключить позиционирование: [ Горизонтальное | Вертикальное ]"/>

					<!-- Кнопки вызова команд прямого изменения диапазона -->
					<StackPanel Orientation="Horizontal" Spacing="5">
						<Button Content="SetRange (now-2h..now)" Click="SetRangeButton_Click" />
						<Button Content="ApplyPreset (last 2h)" Click="ApplyPresetButton_Click" />
						<Button Content="ResetToDefaults" Click="ResetToDefaultsButton_Click" />
					</StackPanel>
					
					<!-- Кнопка вкл/выкл пресеты -->
					<Button Command="{Binding ToggleShowPresetsCommand}"
							Content="Включить/выключить использование пресетов"/>

					<!-- Контрол -->
					<controls:DateTimeRangeSelector x:Name="RangeSelector"
													FromDateTime="{Binding RangeFrom, Mode=TwoWay}"
													ToDateTime="{Binding RangeTo, Mode=TwoWay}"
													MinDateTime="{Binding RangeMin}"
													MaxDateTime="{Binding RangeMax}"
													Orientation="{Binding Orientation}"
													Presets="{Binding Presets}"
													ShowPresets="{Binding ShowPresets}"/>

					<!-- Валидация -->
					<StackPanel Orientation="Horizontal" Spacing="5">
						<TextBlock Text="Валиден:" FontWeight="SemiBold"/>
						<TextBlock Text="{Binding #RangeSelector.IsValid}" />
					</StackPanel>
					<TextBlock Text="{Binding #RangeSelector.ValidationMessage}"
							   Foreground="Red" FontWeight="SemiBold" />
				</StackPanel>
			</Border>

			<!-- Панель переключения логов -->
			<Border BorderBrush="Gray" BorderThickness="1" Padding="5">
				<StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,5">
						<Button Content="Events"
								Command="{Binding ShowEventLogCommand}"
								FontWeight="{Binding EventLogVisible,
								Converter={x:Static converters:BoolToFontWeightConverter.Instance}}"
								Padding="6,2" />
						<Button Content="Observables"
								Command="{Binding ShowObservableLogCommand}"
								FontWeight="{Binding ObservableLogVisible,
								Converter={x:Static converters:BoolToFontWeightConverter.Instance}}"
								Padding="6,2" />
						<Button Content="Очистить Логи"
								Command="{Binding ClearLogsCommand}"
								Padding="6,2" />
					</StackPanel>

					<ItemsControl ItemsSource="{Binding EventLog}"
								  IsVisible="{Binding EventLogVisible}" />
					<ItemsControl ItemsSource="{Binding ObservableLog}"
								  IsVisible="{Binding ObservableLogVisible}" />
				</StackPanel>
			</Border>

		</StackPanel>
	</ScrollViewer>
</UserControl>